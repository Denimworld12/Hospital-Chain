# MedChain hub settings, read by deploy/hub.yml (`make hub`). scripts/provision.py writes a
# filled copy to <kits>/directory/hub.env; docs/MULTI_LAPTOP.md walks through it.

# The directory kit from scripts/provision.py (its config/ and pki/): ./ and relative to the repo
# root, or an absolute path
HUB_KIT=./kits/directory
# The network's shared secret, printed by provision.py (the dashboard's Start / Pause relay sends it)
MEDCHAIN_SHARED_SECRET=change-me-the-provisioned-secret
IMAGE_VERSION=v1.1.0
# The ports in the directory's and the observer's addresses (provision.py --directory / --observer)
DIRECTORY_PORT=8100
OBSERVER_PORT=8200
# The dashboard, on this laptop only: http://localhost:8080
DASHBOARD_BIND_IP=127.0.0.1
DASHBOARD_PORT=8080

# ======== Tailscale (the normal way) ========
# Listen for the hospitals on this laptop's Tailscale IP only (`tailscale ip -4`).
# 0.0.0.0 (every interface) also works.
HUB_BIND_IP=100.101.1.99

# ======== Phone hotspot (fallback) ========
# To switch: put a # in front of the Tailscale line above and remove it below. The hotspot
# hands out addresses that can change, so listen on every interface.
#HUB_BIND_IP=0.0.0.0
