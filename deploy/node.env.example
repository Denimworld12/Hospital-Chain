# MedChain hospital node settings, read by deploy/node.yml (and by `make node-native`).
# A kit from scripts/provision.py comes with this file already filled in as `.env`;
# docs/MULTI_LAPTOP.md walks through it. node/settings.py lists every variable.

# ---- Which hospital this laptop is: check it matches what the organiser told you ----
NODE_ID=hospital-b
NODE_PORT=8002

# ======== Tailscale (the normal way) ========
# This laptop's MagicDNS name (or Tailscale IP, `tailscale ip -4`), with NODE_PORT:
ADVERTISE_ADDR=hospital-b-laptop.tail1234.ts.net:8002
# The organiser's laptop (the hub), which runs the directory and the observer:
DIRECTORY_URL=https://organiser-laptop.tail1234.ts.net:8100
OBSERVER_URL=https://organiser-laptop.tail1234.ts.net:8200

# ======== Phone hotspot (fallback) ========
# To switch: put a # in front of the three Tailscale lines above, remove the # from the
# three lines below, and use the IP addresses the hotspot gave each laptop.
#ADVERTISE_ADDR=192.168.43.21:8002
#DIRECTORY_URL=https://192.168.43.10:8100
#OBSERVER_URL=https://192.168.43.10:8200

# ---- The network: filled in by the kit, the same on every laptop. Don't change. ----
SHARED_SECRET=change-me-the-kit-fills-this-in
IMAGE_VERSION=v1.0.0
# Rounds over a real network take longer than on one machine: give each one time.
ROUND_TIMEOUT_S=15
HTTP_CONNECT_TIMEOUT_S=5
HTTP_READ_TIMEOUT_S=10
